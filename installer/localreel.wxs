<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="$(var.ProductName)"
      Manufacturer="LocalReel"
      Version="$(var.Version)"
      UpgradeCode="$(var.UpgradeCode)"
      Scope="perUser"
      Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of LocalReel is already installed." />
    <!-- Two editions ship: a server-only package and one that also installs the
         desktop shell. They are separate products (different UpgradeCodes) with
         the same install folder, so this entry lets either edition remove the
         other before installing — switching must not leave two "LocalReel"
         entries in Apps & Features pointing at one directory. -->
    <Upgrade Id="$(var.OtherUpgradeCode)">
      <UpgradeVersion Minimum="0.0.0" OnlyDetect="no" Property="OTHEREDITIONFOUND" />
    </Upgrade>
    <MediaTemplate EmbedCab="yes" />

    <!-- Executable icon: used by the shortcuts, Apps & Features, and the
         Explorer entry. -->
    <Icon Id="LocalReelIcon" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="LocalReelIcon" />

    <!-- The install directory is chosen in the wizard (default
         %LOCALAPPDATA%\LocalReel). For unattended installs pass
         INSTALLFOLDER="D:\Apps\LocalReel" on the msiexec command line. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />

    <!-- Finish page: start the application right after installing, so the
         first thing a new user sees is the web UI, not a Start Menu hunt. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch LocalReel" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <CustomAction
        Id="LaunchLocalReel"
        FileRef="LocalReelExe"
        ExeCommand=""
        Execute="immediate"
        Impersonate="yes"
        Return="asyncNoWait" />

    <!-- Per-user install: the program lives beside other per-user programs, and
         the library, database and caches stay in %LOCALAPPDATA%\LocalReel. The
         two used to share one folder, which made "uninstall" and "my library"
         the same question. -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="LocalReel">
          <Directory Id="DocsFolder" Name="docs" />
          <Directory Id="FfmpegFolder" Name="ffmpeg">
            <Directory Id="FfmpegBinFolder" Name="bin" />
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="LocalReel" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <UI>
      <Publish
          Dialog="ExitDialog"
          Control="Finish"
          Order="1"
          Event="DoAction"
          Value="LaunchLocalReel"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>

    <Feature Id="MainFeature" Title="LocalReel" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="FfmpegComponents" />
      <!-- Desktop shell payload, generated by scripts/build-msi.ps1 from the
           staged desktop directory. Empty when no shell was staged, which is
           why the launcher target above is a define. -->
      <ComponentGroupRef Id="DesktopComponents" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="ProductComponents">
      <Component Id="MainExecutable" Directory="INSTALLFOLDER" Guid="D45E80F3-863B-4AC1-8976-39E288EFC6E3">
        <File Id="LocalReelExe" Source="$(var.SourceDir)\localreel.exe" KeyPath="yes" />
      </Component>
      <!-- GUI-subsystem launcher: the shortcuts use it so no console flashes. -->
      <Component Id="DesktopLauncher" Directory="INSTALLFOLDER" Guid="*">
        <File Id="DesktopLauncherExe" Source="$(var.SourceDir)\localreel-desktop.exe" />
      </Component>
      <Component Id="ConfigExample" Directory="INSTALLFOLDER" Guid="*">
        <File Id="ConfigExampleFile" Source="$(var.SourceDir)\localreel.toml.example" />
      </Component>
      <Component Id="Readme" Directory="INSTALLFOLDER" Guid="8858074B-97EF-4190-B8FF-7E33F0F095B4">
        <File Id="ReadmeMd" Source="$(var.SourceDir)\README.md" />
        <File Id="ReadmeTxt" Source="$(var.SourceDir)\README.txt" />
      </Component>
      <Component Id="License" Directory="INSTALLFOLDER" Guid="*">
        <File Id="LicenseFile" Source="$(var.SourceDir)\LICENSE" />
      </Component>
      <Component Id="InstallTask" Directory="INSTALLFOLDER" Guid="*">
        <File Id="InstallTaskScript" Source="$(var.SourceDir)\install-task.ps1" />
      </Component>
      <Component Id="Docs" Directory="DocsFolder" Guid="F27F12C7-8729-414C-BED2-8CB5B2266E5A">
        <File Id="DocInstall" Source="$(var.SourceDir)\docs\install.md" />
        <File Id="DocOperations" Source="$(var.SourceDir)\docs\operations.md" />
        <File Id="DocPackaging" Source="$(var.SourceDir)\docs\packaging.md" />
        <File Id="DocArchitecture" Source="$(var.SourceDir)\docs\architecture.md" />
        <File Id="DocBuilding" Source="$(var.SourceDir)\docs\building.md" />
        <File Id="DocLinux" Source="$(var.SourceDir)\docs\linux.md" />
        <File Id="DocDocker" Source="$(var.SourceDir)\docs\docker.md" />
        <File Id="DocService" Source="$(var.SourceDir)\docs\service.md" />
        <File Id="DocSigning" Source="$(var.SourceDir)\docs\signing.md" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <Component Id="StartMenuShortcut" Directory="ApplicationProgramsFolder" Guid="*">
      <Shortcut
          Id="StartMenuShortcut"
          Name="LocalReel"
          Description="Local-first media server"
          Target="[INSTALLFOLDER]$(var.LauncherExe)"
          WorkingDirectory="INSTALLFOLDER"
          Icon="LocalReelIcon"
          />
      <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\LocalReel" Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- A desktop shortcut costs nothing and saves the "where did it go?"
         moment after the wizard closes. -->
    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="*">
      <Shortcut
          Id="DesktopShortcut"
          Name="LocalReel"
          Description="Local-first media server"
          Target="[INSTALLFOLDER]$(var.LauncherExe)"
          WorkingDirectory="INSTALLFOLDER"
          Icon="LocalReelIcon"
          />
      <RegistryValue Root="HKCU" Key="Software\LocalReel" Name="desktopShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
